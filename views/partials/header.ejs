<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title||'RBAC System' %></title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/style.css" rel="stylesheet"></head><body><nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container"><a class="navbar-brand" href="/">RBAC System</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><div class="navbar-nav me-auto"><a class="nav-link" href="/">Home</a><% if(currentUser){ %><a class="nav-link" href="/dashboard">Dashboard</a><a class="nav-link" href="/profile">Profile</a><% if(['admin','manager'].includes(currentUser.role)){ %><a class="nav-link" href="/manager/dashboard">Users</a><% } if(currentUser.role==='admin'){ %><a class="nav-link" href="/admin/users">Admin Users</a><% } %><% } %></div><div class="navbar-nav"><% if(currentUser){ %><span class="navbar-text me-3"><img class="avatar" src="<%= currentUser.profilePicture||'/images/avatar.svg' %>"> <%= currentUser.name %> (<%= currentUser.role %>)</span><a class="nav-link" href="/profile/change-password">Change Password</a><form action="/logout" method="POST"><button class="btn btn-outline-light btn-sm mt-2">Logout</button></form><% }else{ %><a class="nav-link" href="/login">Login</a><a class="nav-link" href="/register">Register</a><% } %></div></div></div></nav><main class="container py-4"><% if(message){ %><div class="alert alert-info"><%= message %></div><% } %>