<%- include('../partials/header',{title:'Login History'}) %><h1>Login History</h1><div class="table-responsive"><table class="table table-striped"><thead><tr><% if(all){ %><th>User</th><% } %><th>Login</th><th>Logout</th><th>IP</th><th>Browser</th><th>Status</th></tr></thead><tbody><% history.forEach(h=>{ %><tr><% if(all){ %><td><%= h.userId?h.userId.name:'Deleted user' %></td><% } %><td><%= h.loginAt.toLocaleString() %></td><td><%= h.logoutAt?h.logoutAt.toLocaleString():'—' %></td><td><%= h.ipAddress %></td><td><%= h.userAgent %></td><td><%= h.status %></td></tr><% }) %></tbody></table></div><%- include('../partials/footer') %>