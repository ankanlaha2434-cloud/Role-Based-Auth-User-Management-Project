<%- include('../partials/header',{title:'Change Password'}) %><div class="form-card"><h2>Change Password</h2><% (errors||[]).forEach(e=>{ %><div class="alert alert-danger"><%= e.msg %></div><% }) %><form method="POST" action="/profile/change-password"><label class="form-label">Current password</label><input class="form-control mb-3" type="password" name="currentPassword" required><label class="form-label">New password (8+ chars)</label><input class="form-control mb-3" type="password" name="newPassword" minlength="8" required><button class="btn btn-primary">Change</button></form></div><%- include('../partials/footer') %>