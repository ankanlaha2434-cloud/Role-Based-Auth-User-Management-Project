<%- include('../partials/header',{title:'My Profile'}) %><h1>My Profile</h1><div class="card p-4 profile"><img src="<%= user.profilePicture||'/images/avatar.svg' %>" class="profile-img"><h3><%= user.name %></h3><p><%= user.email %></p><p><%= user.mobile %></p><p>Role: <%= user.role %> | Created: <%= user.createdAt.toLocaleDateString() %></p><a class="btn btn-primary" href="/profile/edit">Edit Profile</a></div><div class="card p-4 mt-3"><h4>Change Profile Picture</h4><form action="/profile/upload" method="POST" enctype="multipart/form-data"><input class="form-control mb-3" type="file" name="picture" accept="image/png,image/jpeg,image/webp" required><button class="btn btn-primary">Upload</button></form></div><%- include('../partials/footer') %>