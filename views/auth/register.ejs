<%- include('../partials/header',{title:'Register'}) %><div class="form-card"><h2>Register</h2><% (errors||[]).forEach(e=>{ %><div class="alert alert-danger"><%= e.msg %></div><% }) %><form method="POST" action="/register"><label class="form-label">Full name</label><input class="form-control mb-3" name="name" required><label class="form-label">Email</label><input class="form-control mb-3" type="email" name="email" required><label class="form-label">Mobile</label><input class="form-control mb-3" name="mobile" required><label class="form-label">Password (8+ characters)</label><input class="form-control mb-3" type="password" name="password" minlength="8" required><button class="btn btn-primary w-100">Register</button></form></div><%- include('../partials/footer') %>