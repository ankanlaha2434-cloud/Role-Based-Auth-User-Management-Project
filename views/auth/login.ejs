<%- include('../partials/header',{title:'Login'}) %><div class="form-card"><h2>Login</h2><% (errors||[]).forEach(e=>{ %><div class="alert alert-danger"><%= e.msg %></div><% }) %><form method="POST" action="/login"><label class="form-label">Email</label><input class="form-control mb-3" type="email" name="email" required><label class="form-label">Password</label><input class="form-control mb-3" type="password" name="password" required><button class="btn btn-primary w-100">Login</button></form></div><%- include('../partials/footer') %>