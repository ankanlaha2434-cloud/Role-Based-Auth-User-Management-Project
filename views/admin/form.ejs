<%- include('../partials/header',{title:user?'Edit User':'Create User'}) %><div class="form-card"><h2><%= user?'Edit User':'Create User' %></h2><% (errors||[]).forEach(e=>{ %><div class="alert alert-danger"><%= e.msg %></div><% }) %><form method="POST" action="<%= user?'/admin/users/'+user._id+'?_method=PUT':'/admin/users' %>"><label class="form-label">Name</label><input class="form-control mb-3" name="name" value="<%= user?user.name:'' %>" required><label class="form-label">Email</label><input class="form-control mb-3" type="email" name="email" value="<%= user?user.email:'' %>" required><label class="form-label">Mobile</label><input class="form-control mb-3" name="mobile" value="<%= user?user.mobile:'' %>" required><% if(!user){ %><label class="form-label">Password</label><input class="form-control mb-3" type="password" name="password" minlength="8" required><% } %><label class="form-label">Role</label><select class="form-select mb-3" name="role"><% ['user','manager','admin'].forEach(r=>{ %><option value="<%= r %>" <%= user&&user.role===r?'selected':'' %>><%= r %></option><% }) %></select><% if(user){ %><label><input type="checkbox" name="isActive" <%= user.isActive?'checked':'' %>> Active account</label><% } %><button class="btn btn-primary mt-3">Save</button></form></div><%- include('../partials/footer') %>