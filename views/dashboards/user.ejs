<%- include('../partials/header',{title:'User Dashboard'}) %><h1>Welcome, <%= user.name %>!</h1><p>Your role: <span class="badge bg-primary"><%= user.role %></span></p><div class="row"><div class="col-md-6"><div class="card p-3"><h5>Last login</h5><p>Current session: <%= new Date().toLocaleString() %></p><p>Previous login: <%= previousLogin?new Date(previousLogin).toLocaleString():'First login' %></p><p>Total logins: <%= user.loginCount %></p></div></div><div class="col-md-6"><div class="card p-3"><h5>Quick links</h5><a href="/profile">My Profile</a><a href="/profile/login-history">Login History</a></div></div></div><%- include('../partials/footer') %>